APP_ENV=development
POSTGRES_USER=coach_user
POSTGRES_PASSWORD=coach_password
POSTGRES_DB=github_coach_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://coach_user:coach_password@localhost:5432/github_coach_db
REDIS_URL=redis://localhost:6379/0

# Generate long random values for non-development environments.
SESSION_SECRET=dev-only-change-me-32-bytes-minimum
AUDIT_HMAC_SECRET=dev-only-change-me-32-bytes-minimum
COOKIE_SECURE=false

# GitHub App. Never put a PAT here.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

TENANT_SLUG=se2026-t07
TENANT_NAME=SE2026-T07 Entropy
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BACKFILL_DAYS=90
